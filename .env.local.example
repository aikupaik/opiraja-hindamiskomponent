# Copy this file to .env.local, then replace every placeholder with the
# approved production value. This local stack may create and advance live
# Supabase records and may trigger item generation.
#
# Start it with:
#   docker compose --env-file .env.local up --build

# Make the API service read this selected local file, rather than the VM .env.
APP_ENV_FILE=./.env.local

# Required by the FastAPI assessment orchestrator.
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-production-service-role-key
# Compose overrides this inside the API container with http://r-service:8000.
R_SERVICE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=["127.0.0.1","localhost"]

ADMIN_ACCESS_KEY=replace-with-production-admin-key
OR_JWT_SECRET=replace-with-at-least-32-random-characters-or-secret
API_JWT_SECRET=replace-with-at-least-32-random-characters-api-secret
OR_JWT_ISSUER=your-or-service
PLAYER_APP_URL=http://127.0.0.1:8080

# Optional runtime tuning.
APP_LOG_LEVEL=INFO
MAX_GRAPH_NODES=10
R_MAX_CONNECTIONS=4
R_CONNECT_TIMEOUT_SECONDS=2
R_READ_TIMEOUT_SECONDS=30
R_WRITE_TIMEOUT_SECONDS=5
R_POOL_TIMEOUT_SECONDS=1
READINESS_TIMEOUT_SECONDS=1
SUPABASE_REQUEST_TIMEOUT_SECONDS=10
ADMIN_SOURCE_MAX_BYTES=10000000
ADMIN_SOURCE_MAX_PDF_PAGES=100
ADMIN_SOURCE_MAX_TEXT_CHARS=1000000
ADMIN_SOURCE_MAX_REDIRECTS=5
ADMIN_SOURCE_FETCH_TIMEOUT_SECONDS=10
ADMIN_DIAGNOSTIC_MAX_EVENTS=500
ADMIN_DIAGNOSTIC_TTL_SECONDS=3600
OR_JWT_MAX_LIFETIME_SECONDS=300
PLAYER_JWT_LIFETIME_SECONDS=28800
ADMIN_JWT_LIFETIME_SECONDS=28800
