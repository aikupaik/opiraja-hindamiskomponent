# Required by the FastAPI assessment orchestrator.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-your-service-role-key
# Docker Compose overrides this with http://r-service:8000 inside the API
# container; the loopback value remains suitable for local host development.
R_SERVICE_URL=http://127.0.0.1:8000
# Public deployment identity. Keep the current VM IPv4 during the restricted
# self-signed phase. For the domain cutover, replace it with the final FQDN;
# retain 127.0.0.1 for the API container health check. Wildcards are rejected.
ALLOWED_HOSTS=["193.40.157.124","127.0.0.1"]

# Enables all /api/v1/admin endpoints. Keep this server-side; operators enter
# the value into the admin unlock screen and it is retained only per browser tab.
ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-key

# JWT signing material. Generate each secret from at least 32 random bytes;
# never reuse the API-only secret as the OR integration secret.
OR_JWT_SECRET=replace-with-at-least-32-random-characters-or-secret
API_JWT_SECRET=replace-with-at-least-32-random-characters-api-secret
OR_JWT_ISSUER=your-or-service
# Absolute learner-app origin matching the host Nginx HTTPS endpoint. Replace
# the IP origin with https://<final-fqdn> during the domain cutover. HTTP is
# accepted only for localhost/loopback development.
PLAYER_APP_URL=https://193.40.157.124

# Optional runtime tuning (shown with application defaults).
MAX_GRAPH_NODES=10
R_MAX_CONNECTIONS=4
R_CONNECT_TIMEOUT_SECONDS=2
R_READ_TIMEOUT_SECONDS=30
R_WRITE_TIMEOUT_SECONDS=5
R_POOL_TIMEOUT_SECONDS=1
READINESS_TIMEOUT_SECONDS=1
SUPABASE_REQUEST_TIMEOUT_SECONDS=10
ADMIN_SOURCE_MAX_BYTES=10000000
ADMIN_SOURCE_MAX_PDF_PAGES=100
ADMIN_SOURCE_MAX_TEXT_CHARS=1000000
ADMIN_SOURCE_MAX_REDIRECTS=5
ADMIN_SOURCE_FETCH_TIMEOUT_SECONDS=10
ADMIN_DIAGNOSTIC_MAX_EVENTS=500
ADMIN_DIAGNOSTIC_TTL_SECONDS=3600
OR_JWT_MAX_LIFETIME_SECONDS=300
PLAYER_JWT_LIFETIME_SECONDS=28800
ADMIN_JWT_LIFETIME_SECONDS=28800

# Optional Docker Compose host-port override.
# HTTP_PORT=80

# Optional: enables the manually selected real-R contract test.
# R_CONTRACT_BASE_URL=http://127.0.0.1:8000
