# Required by the FastAPI assessment orchestrator.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-your-service-role-key
R_SERVICE_URL=http://127.0.0.1:8000

# Enables all /api/v1/admin endpoints. Keep this server-side; operators enter
# the value into the admin unlock screen and it is retained only per browser tab.
ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-key

# Optional runtime tuning (shown with application defaults).
MAX_GRAPH_NODES=10
R_MAX_CONNECTIONS=4
R_CONNECT_TIMEOUT_SECONDS=2
R_READ_TIMEOUT_SECONDS=30
R_WRITE_TIMEOUT_SECONDS=5
R_POOL_TIMEOUT_SECONDS=1
READINESS_TIMEOUT_SECONDS=1
SUPABASE_REQUEST_TIMEOUT_SECONDS=10
ADMIN_SOURCE_MAX_BYTES=10000000
ADMIN_SOURCE_MAX_PDF_PAGES=100
ADMIN_SOURCE_MAX_TEXT_CHARS=1000000
ADMIN_SOURCE_MAX_REDIRECTS=5
ADMIN_SOURCE_FETCH_TIMEOUT_SECONDS=10
ADMIN_DIAGNOSTIC_MAX_EVENTS=500
ADMIN_DIAGNOSTIC_TTL_SECONDS=3600

# Optional: enables the manually selected real-R contract test.
# R_CONTRACT_BASE_URL=http://127.0.0.1:8000
